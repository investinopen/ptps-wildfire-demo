{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "uv run quarto preview site --port \"${PORT:-8744}\" --no-browser"
      ],
      "port": 8744,
      "autoPort": true
    },
    {
      "name": "detailed-map",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "uv run python -m http.server \"${PORT:-8745}\" --bind 127.0.0.1 --directory site"
      ],
      "port": 8745,
      "autoPort": true
    }
  ]
}
