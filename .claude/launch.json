{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "uv run quarto preview site --port \"${PORT:-8744}\" --no-browser"
      ],
      "port": 8744,
      "autoPort": true
    },
    {
      "name": "detailed-map",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx --yes http-server@14.1.1 site -p \"${PORT:-8745}\" -a 127.0.0.1 -c-1 --silent"
      ],
      "port": 8745,
      "autoPort": true
    }
  ]
}
