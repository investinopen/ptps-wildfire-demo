{
	admin off
}

:8080 {
	# Upstream is provided per-request via the X-Upstream header,
	# e.g. curl -H "X-Upstream: example.com:443" http://localhost:8080/
	reverse_proxy {http.request.header.X-Upstream} {
		health_uri /health
		health_interval 10s
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		respond @404 "Sorry, this page could not be found." 404

		respond "An unexpected error occurred (status {http.error.status_code})." {http.error.status_code}
	}
}
