<p class="lead">
  Checks the rescue status of the
  <a href="https://github.com/investinopen/ptps-wildfire-demo/blob/main/site/analysis/fire_datasets.csv"
    target="_blank">example data sources</a>. Note that some sites may block our crawler, so it may show an error
  status below when the URL is in fact retrievable in a browser.
</p>
<p class="text-body-secondary">
  Generated
  <time id="generated-at" datetime="{{ generated_at.isoformat() }}">{{ generated_at.strftime("%Y-%m-%d %H:%M UTC")
    }}</time>.
  Updates daily. Source:
  <a href="https://github.com/investinopen/ptps-wildfire-demo" target="_blank">investinopen/ptps-wildfire-demo</a>.
</p>
<script>
  (() => {
    const el = document.getElementById("generated-at");
    const generatedAt = new Date(el.getAttribute("datetime"));
    const minutes = Math.round((Date.now() - generatedAt.getTime()) / 60000);

    const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
    let relative;
    if (minutes < 60) {
      relative = rtf.format(-minutes, "minute");
    } else if (minutes < 60 * 24) {
      relative = rtf.format(-Math.round(minutes / 60), "hour");
    } else {
      relative = rtf.format(-Math.round(minutes / (60 * 24)), "day");
    }

    el.textContent = `${relative} (${el.textContent})`;
  })();
</script>

## Summary

<section>
  <p class="text-body-secondary">Shares of the webpage and example data URLs, leaving out the ones an archive isn't applicable to.</p>
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>Data velocity</th>
        <th>Datasets</th>
        <th>URLs</th>
        <th>Live</th>
        <th>
          In
          <a href="https://web.archive.org/" target="_blank">Wayback Machine</a>
        </th>
        <th>
          In
          <a href="https://portal.datarescueproject.org/" target="_blank">Data Rescue Project
            Portal</a>
        </th>
      </tr>
    </thead>
    <tbody>
      {% for row in summary %}
      <tr{% if loop.last %} class="fw-bold"{% endif %}>
        <th scope="row">{{ row.label }}</th>
        <td>{{ row.datasets }}</td>
        <td>{{ row.urls }}</td>
        <td class="text-nowrap">{{ row.live }}</td>
        <td class="text-nowrap">{{ row.wayback }}</td>
        <td class="text-nowrap">{{ row.drp }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

{% for dataset in datasets %}
{# a Markdown heading rather than an <h2>, so Quarto includes it in the table of contents #}
## {{ dataset.name }}

<section>
  {# on one line, since Quarto would otherwise treat the contents as separate Markdown paragraphs; velocity descriptions from datapackage.json #}
  <p class="text-body-secondary">{{ dataset.description }} <span class="badge text-bg-secondary" title="{% if dataset.data_velocity == 'high' %}Near-real-time or frequently updated feed{% else %}Periodic releases or historical archive{% endif %}">{{ dataset.data_velocity }} velocity</span></p>
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>Type</th>
        <th>Status</th>
        <th>
          In
          <a href="https://web.archive.org/" target="_blank">Wayback Machine</a>?
        </th>
        <th>
          In
          <a href="https://portal.datarescueproject.org/" target="_blank">Data Rescue Project
            Portal</a>?
        </th>
      </tr>
    </thead>
    <tbody>
      {% for row in dataset.rows %}
      <tr>
        <td>{{ row.url | link_label(row.type) }}</td>
        <td>{{ row.status }}</td>
        <td>{% if row.wayback_applicable %}{{ row.wayback_url | yes_no }}{% else %}<span class="fst-italic text-body-secondary">N/A</span>{%
          endif %}
        </td>
        <td>{% if row.drp_applicable %}{{ row.drp_url | yes_no }}{% if row.drp_repositories %}, in
          {% for repository in row.drp_repositories %}{{ repository.url | link_label(repository.name) }}{% if not
          loop.last %}, {% endif %}{% endfor %}{% endif %}{% else %}<span class="fst-italic text-body-secondary">N/A</span>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}
